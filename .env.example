# 可选配置
JW_BASE_URL=https://jwglxt.bjut.edu.cn
JW_TIMEOUT_MS=45000

# ChromaDB + tool-calling RAG 后端（不要把真实 Key 提交到 Git）
# 大模型：任何 OpenAI 兼容接口。默认阿里云百炼（北京），key 与地区绑定
# 百炼上可用 qwen3.8-max、deepseek-v4-pro-0813 等；也可改回 DeepSeek 官方：
#   LLM_API_BASE=https://api.deepseek.com  LLM_MODEL=deepseek-v4-flash
# 旧的 DEEPSEEK_API_KEY / DEEPSEEK_MODEL / DEEPSEEK_API_BASE 仍然有效
LLM_API_KEY=
LLM_MODEL=qwen3.8-max
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=60
LLM_ENABLED=true
# 可选：每次请求附加的 JSON。默认自动关闭思考模式（百炼 enable_thinking=false）
# LLM_EXTRA_BODY={"enable_thinking": false}
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20
RAG_CHROMA_DIR=output/chroma_db
RAG_CHROMA_COLLECTION=bjut_schedule
RAG_MAX_TOOL_ROUNDS=4
RAG_MAX_CHAT_HISTORY_MESSAGES=20
RAG_SESSION_DB=output/sessions.sqlite
RAG_USAGE_DB=output/usage.sqlite
# 全服务每日 token 上限（输入+输出），用完后自动降级为本地检索；0 表示不限制
RAG_DAILY_TOKEN_BUDGET=3000000
# 第 1 教学周周一的日期（YYYY-MM-DD），用于回答“这周/明天”；留空则只告诉模型今天的日期
RAG_SEMESTER_START=

# 账号：用学校邮箱验证码登录
RAG_AUTH_REQUIRED=true
RAG_AUTH_DB=output/auth.sqlite
RAG_ALLOWED_EMAIL_DOMAINS=emails.bjut.edu.cn,bjut.edu.cn,illinois.edu
RAG_USER_DAILY_QUESTIONS=30
RAG_USER_QUESTIONS_PER_MINUTE=5

# 发送验证码的邮箱（Gmail：开启两步验证后，在 Google 账号 → 安全性 → 应用专用密码 生成 16 位密码填到 SMTP_PASSWORD，不要用登录密码）
# 不填 SMTP_HOST 时，验证码只打印在服务器日志里（仅用于本地开发）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
