# 可选配置
JW_BASE_URL=https://jwglxt.bjut.edu.cn
JW_TIMEOUT_MS=45000

# ChromaDB + tool-calling RAG 后端（不要把真实 Key 提交到 Git）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_ENABLED=true
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20
RAG_CHROMA_DIR=output/chroma_db
RAG_CHROMA_COLLECTION=bjut_schedule
RAG_MAX_TOOL_ROUNDS=4
RAG_MAX_CHAT_HISTORY_MESSAGES=20
